# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db

# JWT
JWT_SECRET=change-me-at-least-32-chars-long!!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

# Server
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Idempotency
# redis | memory — where `Idempotency-Key` records are kept. See docs/idempotency.md.
#
#   memory  the default, so a clean clone boots with nothing configured. It
#           deduplicates within one process only, so the retry that a load
#           balancer sends to a second replica executes the operation again —
#           silently. REFUSED in production for that reason.
#   redis   the only setting that is correct with more than one replica.
#           Requires REDIS_URL.
IDEMPOTENCY_STORE=memory
# How long a key stays claimed. 24h matches Stripe's window; the record is what
# makes a retry safe, so it has to outlive the retrying.
IDEMPOTENCY_TTL_SECONDS=86400

# Distributed locking
# redlock | memory — what backs `@Lock()` and `withLock()`. See
# docs/distributed-locking.md.
#
#   memory   the default, so a clean clone boots with nothing configured. It
#            excludes callers within one process only, so a second replica takes
#            every lock the first one holds — silently. REFUSED in production.
#   redlock  a majority of independent Redis masters. Requires REDLOCK_NODES,
#            or REDIS_URL for a single-node (development) setup.
DISTRIBUTED_LOCK=memory
# Comma-separated URLs of the independent Redis masters Redlock votes over.
# They must NOT replicate to each other: a lock acknowledged by a primary and
# not yet replicated is simply absent from the replica that gets promoted.
# Three or more, or one node failing takes every lock with it.
REDLOCK_NODES=redis://localhost:6379,redis://localhost:6380,redis://localhost:6381

# Storage
# s3 | local | memory — the backend StorageService stores files through.
#
#   memory  the default, so a clean clone boots with nothing configured. Every
#           object is lost on restart, so it is REFUSED in production.
#   local   real files under STORAGE_LOCAL_ROOT. Fine for one node or for
#           docker-compose; two replicas do not share a disk, so an object
#           written by one is a 404 from the other.
#   s3      Amazon S3 or anything that speaks its API (MinIO, LocalStack, R2).
#           The only backend that survives more than one replica, and the only
#           one that can issue presigned URLs.
#
# Selecting s3 without all three credentials below is a boot failure, not a
# 503 on the first upload.
STORAGE_ADAPTER=memory
STORAGE_LOCAL_ROOT=./storage

# Worker pool
# piscina | inline — which WorkerPool runs CPU-bound tasks.
#
#   inline   the default. Runs each task on the caller's thread inside a
#            resolved promise. Preserves the pool's observable contract
#            (bounded backlog, stats(), shutdown()) but does NOT offload work
#            or isolate. Fine for tests; a knowingly-degraded choice for a
#            small deployment where blocking the event loop for a few dozen
#            milliseconds is not a concern.
#   piscina  a real worker_threads pool with a bounded queue. Production.
WORKER_POOL=inline
# Hard cap on concurrent workers. Piscina's own default is
# availableParallelism() - 1, which is invisible to a container's cgroup CPU
# quota — pick a number you mean.
WORKER_POOL_MAX_THREADS=2
# Hard cap on TOTAL outstanding tasks (queued + running). Over it, run()
# rejects fast with WorkerPoolSaturatedError — turn that into a 503.
WORKER_POOL_MAX_QUEUE=32
# Default wait a `run()` will tolerate before rejecting with
# WorkerPoolTimeoutError. Overridable per call. The wait ends; the worker
# keeps burning until the task returns — Piscina cannot cancel a running task.
WORKER_POOL_TASK_TIMEOUT_MS=30000

# S3 (required when STORAGE_ADAPTER=s3)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# Set for an S3-compatible store; forces path-style addressing, which MinIO and
# LocalStack need because they have no wildcard DNS. Leave empty for real S3.
S3_ENDPOINT=

# Payments
# stripe | paypal | mock — the gateway PaymentProviderFactory hands out by
# default. Anything other than `mock` must have its credentials set below, or
# the app refuses to boot.
PAYMENTS_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_API_BASE_URL=https://api.stripe.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox by default; live is https://api-m.paypal.com
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# Notifications
# Every channel is optional. A channel without credentials reports itself
# unconfigured and NotificationDispatcher skips it, so an app with no Twilio
# account still delivers email and push. Which channels a given user gets is
# decided by their saved preferences, never by these variables.
#
# SMS (Twilio). Set the account SID, the auth token, and exactly one sender:
# a number for a trial account, a messaging service (MG...) in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_API_BASE_URL=https://api.twilio.com
#
# Push (Expo). Expo's push endpoint accepts unauthenticated requests, so the
# push channel stays disabled until an access token is supplied — otherwise
# anyone holding a device token could push to that device.
EXPO_ACCESS_TOKEN=
EXPO_PUSH_API_BASE_URL=https://exp.host

# Transactional outbox (docs/outbox.md)
# Every setting has a default; a clean clone needs none of them. The relay is on
# by default because an outbox nobody drains is a queue that only grows, and
# running it on every replica is the intended shape — the claim is
# FOR UPDATE SKIP LOCKED, so replicas take disjoint batches. Turn it off for a
# topology that relays from a dedicated worker, or for a test that drives
# runOnce() itself.
OUTBOX_RELAY_ENABLED=true
# Added latency on every event, against a query per replica per tick.
OUTBOX_POLL_INTERVAL_MS=1000
# Rows claimed per pass. They are held under row locks for the whole pass, so
# this is really "how many events one relay may hide from the others at once".
OUTBOX_BATCH_SIZE=50
# Bounds the drain transaction: without it, a broker that stops answering holds
# the batch's row locks until the transaction timeout fires much later.
OUTBOX_PUBLISH_TIMEOUT_MS=5000
# Full-jitter ladder. 8 attempts from a 500ms base is a little over twenty
# minutes of retrying before the event is dead-lettered for a human to look at.
OUTBOX_BACKOFF_BASE_MS=500
OUTBOX_BACKOFF_MAX_MS=300000
OUTBOX_MAX_ATTEMPTS=8

# Messaging — Kafka producer and consumer (docs/messaging.md)
# Which implementation the outbox relay delivers through. `bus` hands the event
# to this process's DomainEventBus: durable and retried, but reaching no other
# replica. `broker` produces it to the topic below, where every consumer group
# over that topic gets a copy — in this service and in any other. Still `bus` by
# default so a clean clone boots with no broker installed.
OUTBOX_PUBLISHER=bus
# `memory` is a working in-process broker (partitions, consumer groups,
# committed offsets), which is the right backend for tests and a development run
# with nothing installed. It is refused in production with OUTBOX_PUBLISHER=broker,
# because a broker inside the process reaches no other process.
MESSAGE_BROKER=memory
# Required when MESSAGE_BROKER=kafka. Comma-separated bootstrap brokers.
KAFKA_BROKERS=
# Identifies this application in broker logs, quota config and
# `kafka-consumer-groups --describe`.
KAFKA_CLIENT_ID=boilerplate-nestjs-api
# One topic for every domain event, keyed by the aggregate. Kafka orders within
# a partition and a partition belongs to a topic, so splitting the catalogue by
# event name would leave no order between `user.registered` and `user.deleted`
# for the same user.
KAFKA_DOMAIN_EVENTS_TOPIC=domain-events
# The ceiling on consumer parallelism: a group runs at most one member per
# partition. Can be raised later, never lowered, and raising it re-hashes keys.
KAFKA_TOPIC_PARTITIONS=3
# Creates the topic at boot if it is missing. Set false where topics are managed
# externally, so a typo is an error rather than a new empty topic.
KAFKA_ENSURE_TOPICS=true
# Whether this process reads the topic. False for a produce-only replica.
KAFKA_CONSUMER_ENABLED=true
# ONE value for the whole deployment. Every replica sharing it is what makes the
# replicas split the partitions and handle each event once; deriving it from a
# hostname sends every welcome email once per replica.
KAFKA_CONSUMER_GROUP_ID=boilerplate-nestjs-api
# Must sit between the broker's group.min/max.session.timeout.ms (6s-30min).
KAFKA_SESSION_TIMEOUT_MS=30000
# At most a third of the session timeout, so a member survives a lost heartbeat.
KAFKA_HEARTBEAT_INTERVAL_MS=3000
# A floor on the redelivery interval, not the interval: the effective gap is
# max(this, maxWaitTimeInMs), about 5s with KafkaJS's default fetch settings.
KAFKA_REDELIVERY_DELAY_MS=1000
KAFKA_SUBSCRIBE_TIMEOUT_MS=30000
# How long one subscriber may take before the message is treated as failed and
# redelivered. A handler that never settles is worse than one that throws: the
# consumer sits inside eachMessage, stops heartbeating, and is evicted from its
# group — so the service stops consuming while /health stays green and nothing
# is logged. That is not hypothetical; it is what this application did the first
# time it ran against a real cluster with Redis down.
KAFKA_HANDLER_TIMEOUT_MS=60000
# A message the consumer has given up on is copied to the dead-letter topic and
# committed past, so it stops holding its partition. Set false to keep the older
# behaviour — an exhausted message is redelivered forever and its partition
# stalls — which is the right choice only where a gap in the stream is worse
# than a stop.
KAFKA_DEAD_LETTER_ENABLED=true
# Defaults to <KAFKA_DOMAIN_EVENTS_TOPIC>.dlt when left blank, so renaming the
# events topic moves the dead-letter topic with it. Nothing consumes this topic:
# redriving is a human decision made after the cause is fixed.
KAFKA_DEAD_LETTER_TOPIC=
# The retry ladder, run in place before giving up. Full jitter, so a dependency
# that comes back does not meet the whole consumer group at once. The ladder
# runs inside one handler call, so its sleeps must fit well inside
# KAFKA_HANDLER_TIMEOUT_MS — the schema refuses a combination that does not,
# because a handler cut off mid-ladder is redelivered with a fresh budget and
# never reaches the dead-letter topic at all.
KAFKA_RETRY_MAX_ATTEMPTS=4
KAFKA_RETRY_BASE_MS=250
KAFKA_RETRY_MAX_DELAY_MS=5000
KAFKA_CONNECTION_TIMEOUT_MS=10000
KAFKA_REQUEST_TIMEOUT_MS=30000
# TLS and SASL. `plain` sends the password in the clear and is refused without
# KAFKA_SSL=true; scram-sha-256 / scram-sha-512 do not and are allowed over a
# plaintext connection. Credentials come from the environment — never commit them.
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ---------------------------------------------------------------------------
# Server-Sent Events (GET /v1/events/stream)
# ---------------------------------------------------------------------------
# Keep-alive interval for an idle stream. An idle SSE connection is
# indistinguishable from a dead one to every proxy in front of this process, and
# they close it — 60s for nginx and an AWS ALB, 30s for some CDNs. A quarter of
# the tightest of those survives losing two keep-alives to a blip.
SSE_HEARTBEAT_INTERVAL_MS=15000
# How many recent events are kept for a reconnecting client to be caught up
# from. Counted in events rather than seconds, so memory is bounded regardless
# of the event rate — at the cost of the resumable window shrinking as traffic
# rises. docs/streaming.md works the arithmetic against a peak rate.
SSE_REPLAY_BUFFER_SIZE=1024
# The most streams this process holds open at once. SSE connections are held
# rather than served and released, so nothing else in the request path bounds
# them; over the limit is a 503 the load balancer can shed to another replica.
SSE_MAX_CONNECTIONS=1000
# The `retry:` hint clients are told to wait before reconnecting. EventSource
# defaults to ~3s and does not back off, so every connection a deploy drops
# comes back together against a process that is still warming up.
SSE_RETRY_HINT_MS=3000

# ---------------------------------------------------------------------------
# WebSocket gateway (wss://…/v1/realtime)
# ---------------------------------------------------------------------------
# The most simultaneous sockets this process holds. Separate from
# SSE_MAX_CONNECTIONS because a WebSocket also carries a send buffer bounded by
# WS_SEND_HIGH_WATER_MARK_BYTES, so one connection costs far more than one
# stream does.
WS_MAX_CONNECTIONS=1000
# The most rooms one connection may hold. A memory bound: an administrator may
# subscribe to any `user:<id>` room, and each room name is a map key held for
# the life of the connection.
WS_MAX_ROOMS_PER_CONNECTION=64
# Bytes of unflushed send buffer past which a connection stops being sent
# events. `send()` on a peer that stopped reading neither blocks nor fails, so
# without this one slow client is an unbounded allocation. See docs/realtime.md.
WS_SEND_HIGH_WATER_MARK_BYTES=1048576
# How long a connection may stay over that mark before it is closed with 4408.
# The gap between "a burst it will catch up from" and "a peer that is not
# reading".
WS_SLOW_CONSUMER_GRACE_MS=10000
# How often every connection is pinged, and the deadline for its pong. A
# WebSocket that has lost its peer is otherwise invisible: nothing is written
# and the OS may hold the TCP connection for hours.
WS_HEARTBEAT_INTERVAL_MS=30000

# ---------------------------------------------------------------------------
# Saga orchestration (docs/saga.md)
# ---------------------------------------------------------------------------
# Whether this replica advances sagas that nothing is currently driving. A
# checkout is advanced inside the request that placed it, so this poller is the
# crash-recovery path: with it off on every replica, a saga interrupted between
# two steps stays where it stopped — money captured and nothing shipped.
SAGA_RECOVERY_ENABLED=true
# How long an interrupted saga may sit before a poller picks it up. Not latency
# on the happy path.
SAGA_POLL_INTERVAL_MS=1000
# Instances claimed per pass. Each one is a chain of remote calls; keep it small.
SAGA_RECOVERY_BATCH_SIZE=20
# How long a claim on a saga is good for. A lease rather than a row lock,
# because a step is an arbitrary remote call and holding a transaction across
# one parks a database connection on somebody else's network. Must be more than
# twice SAGA_STEP_TIMEOUT_MS — the config refuses to boot otherwise, because a
# lease that expires mid-step lets a second runner start the same step, which
# for a payment means charging twice.
SAGA_LEASE_MS=30000
# How long one step may take before the orchestrator stops waiting. It bounds
# the wait, not the step: JavaScript has no cancellation, so the call carries on
# and its side effect happens anyway. That is why every participant is
# idempotent on the step's key.
SAGA_STEP_TIMEOUT_MS=10000
# First retry delay for a failing step, before jitter. The ladder doubles.
SAGA_BACKOFF_BASE_MS=500
# Ceiling on the retry delay, so the ladder plateaus rather than running away.
SAGA_BACKOFF_MAX_MS=60000
# Attempts a step gets before the saga gives up and turns around. Shorter than
# the outbox's ladder because a customer is waiting on the other end of a
# checkout: a compensated order they can see beats a spinner they cannot.
SAGA_MAX_ATTEMPTS=6

# Outbound HTTP resilience
# Every call to Stripe, PayPal, Twilio and Expo goes through one circuit breaker
# per dependency, with a full-jitter retry ladder around the calls that can
# safely take one. See docs/http-resilience.md.
#
# Attempts one call gets, the first included. Applies only to requests that may
# be replayed — a safe method, or a POST carrying an idempotency key — so a
# refund and an SMS are never repeated whatever this is set to. 1 disables
# retrying without disabling the breaker.
HTTP_RETRY_MAX_ATTEMPTS=3
# Delay before the second attempt, before jitter. The ladder doubles from here.
HTTP_RETRY_BASE_MS=200
# Ceiling on the delay, and the longest Retry-After the ladder will honour
# rather than give up on. Small, because somebody is waiting on the request.
HTTP_RETRY_MAX_DELAY_MS=2000
# Failure rate, as a percentage of the rolling window, above which a
# dependency's breaker opens. Only calls that reached the dependency are in the
# denominator: a 4xx that is not 408 or 429 is a correct answer, not a failure.
HTTP_BREAKER_FAILURE_THRESHOLD_PERCENT=50
# Calls the window must hold before that percentage may open the breaker.
# Without it, the first call of a quiet minute failing is a 100% failure rate
# over a sample of one.
HTTP_BREAKER_VOLUME_THRESHOLD=10
# How much history the failure rate is computed over, and how many buckets that
# window advances through. The window must be at least the bucket count — the
# config refuses to boot otherwise, because opossum divides one by the other and
# a zero-length bucket is a timer that never stops firing.
HTTP_BREAKER_ROLLING_WINDOW_MS=10000
HTTP_BREAKER_ROLLING_BUCKETS=10
# How long an open breaker rejects calls before letting one probe through. This
# is the wait a caller is told about in the 503 they get.
HTTP_BREAKER_RESET_TIMEOUT_MS=30000
# The bulkhead: calls one dependency may have in flight at once, and callers
# that may queue for a permit before requests are refused without being sent.
# It is what covers the dependency that is slow rather than broken — the
# breaker needs finished failures before it can react, and one answering just
# inside its timeout never supplies any. Per dependency, so a slow gateway
# cannot spend the budget the SMS provider needs.
HTTP_BULKHEAD_MAX_CONCURRENT=20
HTTP_BULKHEAD_MAX_QUEUED=20
# How long a call waits for a permit before it is refused. Short: a queue is
# worth having for the burst that clears in a moment, and waiting longer than
# this is time the caller could have spent being told no.
HTTP_BULKHEAD_QUEUE_TIMEOUT_MS=1000
# Hard ceiling on one outbound call — the queue wait, every attempt, and every
# sleep between them. The per-attempt timeout bounds a socket; this bounds the
# call, and each attempt is clamped to whatever is left of it. Must be greater
# than HTTP_BULKHEAD_QUEUE_TIMEOUT_MS or a contended call could spend its whole
# budget queueing; the config refuses to boot otherwise.
HTTP_REQUEST_DEADLINE_MS=25000

# ---------------------------------------------------------------------------
# OpenTelemetry — traces, metrics and logs
# ---------------------------------------------------------------------------
# Where the SDK sends what it collects.
#   none     — nothing is installed at all. No tracer provider, no meter
#              provider, no propagator, no instrumentation, so every span in the
#              codebase is a no-op that allocates nothing. This is the default,
#              and it is why a clean clone needs no collector.
#   console  — spans, metrics and log records to stdout, for seeing the shape of
#              the data while developing. Refused in production: it multiplies
#              the log volume without putting the data anywhere queryable.
#   otlp     — OTLP over HTTP to a collector. Needs the endpoint below.
OTEL_EXPORTER=none
# service.name on every signal. The one attribute every backend groups by; left
# unset the SDK falls back to "unknown_service:node".
OTEL_SERVICE_NAME=boilerplate-nestjs-api
# service.version. Optional, and omitted rather than defaulted when unset —
# a made-up 0.0.0 makes every deploy look like the same build. Set it from the
# image tag or the commit sha in the deployment.
# OTEL_SERVICE_VERSION=
# The collector's BASE endpoint. The signal path (/v1/traces, /v1/metrics,
# /v1/logs) is appended — pointing this at one signal sends the other two there
# too, which a collector answers with a 400 the SDK only logs to itself.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Extra headers on every OTLP request, as "key=value,key=value". This is how a
# hosted collector is authenticated, so it is A CREDENTIAL: it belongs in the
# secret store next to JWT_SECRET and never in a checked-in .env.
# OTEL_EXPORTER_OTLP_HEADERS=api-key=replace-me
# Head-sampling probability for a trace this service starts, 0..1. A request
# that arrives with a traceparent is never resampled — it inherits the decision,
# which is what keeps a distributed trace whole instead of full of holes. 1 is
# right for development and for low traffic; lower it when the volume, not the
# usefulness, becomes the problem.
OTEL_TRACES_SAMPLER_ARG=1
# How often metrics are pushed. 60s is the specification's own default.
OTEL_METRIC_EXPORT_INTERVAL_MS=60000
# How long shutdown waits for the last batch to leave. Bounded, because it is
# spent inside the process's own shutdown budget: a collector that has stopped
# answering must not turn a rolling deploy into a force-exit.
OTEL_SHUTDOWN_TIMEOUT_MS=5000
